<?xml version="1.0"?>
<sdf version="1.6">
  <world name="vincent_twin_world">
    <scene><ambient>0.4 0.4 0.4 1</ambient><background>0.7 0.7 0.7 1</background><shadows>1</shadows></scene>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>10</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <light name='user_point_light_0' type='point'>
      <pose>-2.63205 2.46436 1 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>20</range><constant>0.5</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>0</cast_shadows><direction>0 0 -1</direction>
    </light>
    <light name='user_point_light_0_clone' type='point'>
      <pose>-0.286665 -3.0854 4 0 0 0</pose>
      <diffuse>0.498039 0.498039 0.498039 1</diffuse><specular>0.0980392 0.0980392 0.0980392 1</specular>
      <attenuation><range>100</range><constant>0.15</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>0</cast_shadows><direction>0 0 -1</direction>
    </light>
    <model name="ground_collision"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision></link></model>
    <!-- Arena: its collision walls are seen by the twin's scan. Keep the scan max range (3 m)
         shorter than the distance to the arena walls/net, or load a visual-only arena. -->
    <include><uri>model://UZ_arena_twin</uri><pose>0.000054 0 -0.009488 0 -0.005698 0</pose></include>
    <include><uri>model://vincent_twin</uri><pose>0 0 0.2 0 0 0</pose></include>

    <!-- Virtual wall: exists only in the twin. Move it at runtime with /gazebo/set_model_state. -->
    <model name="virtual_wall">
      <static>true</static>
      <pose>6 -0.28 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 3.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 3.0 2.0</size></box></geometry>
          <material><ambient>1 0 0 0.6</ambient><diffuse>1 0 0 0.6</diffuse></material>
          <transparency>0.4</transparency>
        </visual>
      </link>
    </model>

    <physics type="ode"><real_time_factor>1.0</real_time_factor><max_step_size>0.001</max_step_size></physics>
  </world>
</sdf>
